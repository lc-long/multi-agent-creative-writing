# Multi-Agent Creative Writing System - Environment Variables
# 复制此文件为 .env 并填入实际值

# =============================================================================
# 应用配置
# =============================================================================
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# =============================================================================
# 数据库配置
# =============================================================================
# 开发环境使用SQLite
DATABASE_URL=sqlite+aiosqlite:///./data/writing.db
# 生产环境使用PostgreSQL（需要先启动docker compose）
# DATABASE_URL=postgresql+asyncpg://writing_user:writing_pass@localhost:5432/writing_db

# =============================================================================
# LLM配置
# =============================================================================
# OpenAI API配置
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4

# 可选：使用其他LLM提供商
# ANTHROPIC_API_KEY=your-anthropic-api-key
# ANTHROPIC_MODEL=claude-3-opus-20240229

# =============================================================================
# Agent配置
# =============================================================================
# 最大Token数
MAX_TOKENS=4000

# 温度参数（0-2，越高越有创意）
TEMPERATURE=0.7

# 讨论轮数
DISCUSSION_ROUNDS=3

# Agent超时时间（秒）
AGENT_TIMEOUT=60

# =============================================================================
# 安全配置
# =============================================================================
# JWT密钥（用于用户认证，V1暂不实现）
# JWT_SECRET_KEY=your-secret-key-here
# JWT_ALGORITHM=HS256
# JWT_EXPIRATION_HOURS=24

# =============================================================================
# 日志配置
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# =============================================================================
# 其他配置
# =============================================================================
# 启用CORS（开发环境）
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# 速率限制（每分钟请求数）
RATE_LIMIT_PER_MINUTE=60
